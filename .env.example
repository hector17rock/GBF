# Copy this file to .env (do NOT commit .env)
#
# cp .env.example .env

# --- Postgres ---
POSTGRES_DB=gbf
POSTGRES_USER=gbf
POSTGRES_PASSWORD=change-me

# --- Backend ---
# Comma-separated list of allowed frontend origins
# Example: https://tu-dominio.com,https://www.tu-dominio.com
CORS_ORIGINS=http://localhost:5173

# Required to create the first admin via POST /auth/bootstrap
ADMIN_BOOTSTRAP_TOKEN=change-me

# Optional: host port to publish backend
BACKEND_PORT=8000
